{
  "name": "cranklink-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "astro build && node scripts/check-build.mjs",
    "build:cloudflare": "npm ci && npm run check && npm test && npm run build",
    "preview": "astro preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "parse5": "^8.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.0",
    "wrangler": "^4.151.1"
  }
}
