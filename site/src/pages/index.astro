---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import AppLinks from "../components/AppLinks.astro";
import FooterSections from "../components/FooterSections.astro";
import { Image } from "astro:assets";
import screenshot from "../../../docs/images/web-instrument.png";
import motorPhoto from "../../../docs/images/ep800-recovery/opened-motor-cleaned.png";
import { cliExamples, connections, motors, settingGroups } from "../lib/home";

const repo = "https://github.com/plainoss/cranklink";
---

<Base
  title="Change Shimano STEPS assist speed and settings over Bluetooth · cranklink"
  description="Free, open-source app to change your Shimano STEPS e-bike's region and assist speed, assist profiles, wheel size, lights and Di2 settings over Bluetooth or USB. Web app, Android app and command line."
>
  <div class="wrap">
    <Header />
    <main id="main">
      <section class="hero">
        <div class="intro">
          <p class="eyebrow">Shimano STEPS / Free and open source</p>
          <h1>Raise your e-bike's assist speed. From your phone. Free.</h1>
          <p class="lead">
            Switch your Shimano STEPS motor's region over Bluetooth, then tune
            assist, lights, wheel size and shifting. No dealer visit, no licence
            key, no account.
          </p>
          <AppLinks />
        </div>

        <div class="picker tabs" id="speed">
          <fieldset class="tablist chips">
            <legend>What's possible on your motor</legend>
            {motors.map((motor, index) => (
              <label>
                <input
                  type="radio"
                  name="motor"
                  value={motor.id}
                  checked={index === 0}
                />
                <span>{motor.name}</span>
              </label>
            ))}
          </fieldset>
          <div class="panels">
            {motors.map((motor) => (
              <div class="panel motor tabs">
                <fieldset
                  class="tablist chips"
                  aria-label={`Region for ${motor.name}`}
                >
                  {motor.regions.map((region, index) => (
                    <label>
                      <input
                        type="radio"
                        name={`region-${motor.id}`}
                        value={region.id}
                        checked={index === motor.regions.length - 1}
                      />
                      <span>
                        {region.name} · {region.max}
                      </span>
                    </label>
                  ))}
                </fieldset>
                <div class="panels">
                  {motor.regions.map((region) => (
                    <div class="panel result">
                      <p class="speed">
                        <span class="number">{region.max}</span>
                        <span>km/h assist in {region.name}</span>
                      </p>
                      <div class="bar" aria-hidden="true">
                        <span class={`fill fill-${region.max}`} />
                      </div>
                      <p class="detail">{region.detail}</p>
                    </div>
                  ))}
                </div>
                <p class:list={["status", { good: motor.tested }]}>
                  {motor.status}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section tabs" id="connect">
        <div class="sectionhead">
          <div>
            <p class="eyebrow">Connect your way</p>
            <h2>Bluetooth for most. Wired for the rest.</h2>
          </div>
          <fieldset class="tablist segmented" aria-label="Connection">
            {connections.map((connection, index) => (
              <label>
                <input
                  type="radio"
                  name="connection"
                  value={connection.id}
                  checked={index === 0}
                />
                <span>{connection.name}</span>
              </label>
            ))}
          </fieldset>
        </div>
        <div class="panels">
          {connections.map((connection) => (
            <div class="panel connection">
              <h3 class="visually-hidden">{connection.name}</h3>
              {connection.columns.map((column) => (
                <div class="column">
                  <h4>{column.heading}</h4>
                  <ul>
                    {column.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))}
        </div>
        <p class="sectionnote">
          Put the display or wireless unit into connection mode first; the app
          shows the buttons for your parts.{" "}
          <a href={`${repo}/blob/main/docs/bluetooth.md#connection-mode`}>
            Connection mode for each part ↗
          </a>
        </p>
      </section>

      <section class="section tabs" id="settings">
        <div class="sectionhead">
          <div>
            <p class="eyebrow">More than speed</p>
            <h2>Everything else you can change.</h2>
          </div>
          <p>
            What appears depends on the motor, its firmware and the part. The
            app explains each setting next to its value.
          </p>
        </div>
        <div class="settings">
          <fieldset class="tablist side" aria-label="Setting group">
            {settingGroups.map((group, index) => (
              <label>
                <input
                  type="radio"
                  name="settings"
                  value={group.id}
                  checked={index === 0}
                />
                <span>
                  <strong>{group.name}</strong>
                  <small>{group.summary}</small>
                </span>
              </label>
            ))}
          </fieldset>
          <div class="panels">
            {settingGroups.map((group) => (
              <div class="panel group">
                <h3>{group.name}</h3>
                <p>{group.intro}</p>
                <div class="tablewrap">
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Setting</th>
                        <th scope="col">What it does</th>
                        <th scope="col">Values</th>
                      </tr>
                    </thead>
                    <tbody>
                      {group.rows.map((row) => (
                        <tr>
                          <th scope="row">{row.name}</th>
                          <td>{row.what}</td>
                          <td>{row.values}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="inline-note">{group.note}</p>
              </div>
            ))}
          </div>
        </div>
        <figure class="appshot">
          <Image
            src={screenshot}
            widths={[480, 800, 1200]}
            sizes="(max-width: 900px) calc(100vw - 44px), 900px"
            width={1200}
            format="webp"
            loading="lazy"
            alt="Cranklink web app showing assist profile settings using simulator data"
          />
          <figcaption class="caption">
            Assist profiles in the web app. Simulator data shown.
          </figcaption>
        </figure>
        <p class="sectionnote">
          <a href={`${repo}/blob/main/docs/settings.md`}>
            Full settings reference ↗
          </a>
        </p>
      </section>

      <section class="section safety">
        <div>
          <h2>Before you change anything.</h2>
          <p>
            Above 25 km/h your bike may not be legal on public roads where you
            live, and changes can void your warranty. cranklink is unofficial
            and not made by Shimano. Most motors are still in preview.
          </p>
        </div>
        <div class="safetynet">
          <h3>Every write can be undone</h3>
          <ul>
            <li>A backup is saved before every write</li>
            <li>The value is read back from the motor afterwards</li>
            <li>Restore the previous setting from the app</li>
            <li>Only speeds the region allows are written</li>
          </ul>
        </div>
      </section>

      <FooterSections>
        <p class="fold" aria-hidden="true">
          <span>For tinkerers</span>
        </p>
        <section class="section tabs" id="cli">
          <div class="cliintro">
            <h2>Firmware and the command line.</h2>
            <p>
              The same Rust core runs a command line tool for Linux, macOS and
              Windows. Script settings, flash motor firmware from your own
              files, or bring back a motor stuck in its bootloader.
            </p>
            <fieldset class="tablist side" aria-label="Command line example">
              {cliExamples.map((example, index) => (
                <label>
                  <input
                    type="radio"
                    name="cli"
                    value={example.id}
                    checked={index === 0}
                  />
                  <span>
                    <strong>{example.name}</strong>
                  </span>
                </label>
              ))}
            </fieldset>
            <div class="textlinks">
              <a href={`${repo}/releases`}>CLI downloads ↗</a>
              <a href={`${repo}#recover-a-motor-stuck-in-bootloader-mode`}>
                Recovery guide ↗
              </a>
              <a href={`${repo}/blob/main/docs/etube-protocol.md`}>
                Protocol notes ↗
              </a>
              <a href={repo}>Source ↗</a>
            </div>
          </div>
          <div class="panels">
            {cliExamples.map((example) => (
              <div class="panel terminal">
                <h3 class="visually-hidden">{example.name}</h3>
                <pre
                  tabindex="0"
                  aria-label={`${example.name} commands`}
                ><code>{example.code}</code></pre>
                <p>{example.note}</p>
              </div>
            ))}
          </div>
        </section>
        <section class="section story">
          <div>
            <p class="eyebrow">How it started</p>
            <h2>One bricked motor. An open notebook.</h2>
            <p>
              cranklink began with an EP800-CRG that official tools and dealer
              service could not restore. The recovery work grew into a shared
              Rust core, browser and native tools, and public protocol notes.
            </p>
          </div>
          <figure>
            <Image
              src={motorPhoto}
              widths={[480, 800, 1200]}
              sizes="(max-width: 760px) calc(100vw - 44px), 560px"
              width={1200}
              format="webp"
              loading="lazy"
              alt="Opened EP800 motor and exposed electronics from the project's hardware recovery work"
            />
            <figcaption class="caption">Inside an EP800 motor.</figcaption>
          </figure>
        </section>
      </FooterSections>
    </main>
  </div>
</Base>
<style>
  /* Radio-driven views, no JavaScript. Without :has() every view is shown. */
  .tablist {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .tablist label {
    position: relative;
    cursor: pointer;
  }
  .tablist input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .tablist input:focus-visible + span {
    outline: 3px solid #d77b30;
    outline-offset: 3px;
  }
  @supports selector(:has(*)) {
    .tabs > .panels > .panel,
    .settings > .panels > .panel {
      display: none;
    }
    .tabs:has(> .tablist > label:nth-of-type(1) > input:checked)
      > .panels
      > .panel:nth-child(1),
    .tabs:has(> .tablist > label:nth-of-type(2) > input:checked)
      > .panels
      > .panel:nth-child(2),
    .tabs:has(> .tablist > label:nth-of-type(3) > input:checked)
      > .panels
      > .panel:nth-child(3),
    .tabs:has(> .tablist > label:nth-of-type(4) > input:checked)
      > .panels
      > .panel:nth-child(4),
    .tabs:has(> .sectionhead > .tablist > label:nth-of-type(1) > input:checked)
      > .panels
      > .panel:nth-child(1),
    .tabs:has(> .sectionhead > .tablist > label:nth-of-type(2) > input:checked)
      > .panels
      > .panel:nth-child(2),
    .tabs:has(> .cliintro > .tablist > label:nth-of-type(1) > input:checked)
      > .panels
      > .panel:nth-child(1),
    .tabs:has(> .cliintro > .tablist > label:nth-of-type(2) > input:checked)
      > .panels
      > .panel:nth-child(2),
    .tabs:has(> .cliintro > .tablist > label:nth-of-type(3) > input:checked)
      > .panels
      > .panel:nth-child(3),
    .tabs:has(> .cliintro > .tablist > label:nth-of-type(4) > input:checked)
      > .panels
      > .panel:nth-child(4),
    .settings:has(> .tablist > label:nth-of-type(1) > input:checked)
      > .panels
      > .panel:nth-child(1),
    .settings:has(> .tablist > label:nth-of-type(2) > input:checked)
      > .panels
      > .panel:nth-child(2),
    .settings:has(> .tablist > label:nth-of-type(3) > input:checked)
      > .panels
      > .panel:nth-child(3),
    .settings:has(> .tablist > label:nth-of-type(4) > input:checked)
      > .panels
      > .panel:nth-child(4),
    .settings:has(> .tablist > label:nth-of-type(5) > input:checked)
      > .panels
      > .panel:nth-child(5),
    .settings:has(> .tablist > label:nth-of-type(6) > input:checked)
      > .panels
      > .panel:nth-child(6) {
      display: block;
    }
    .connection.panel {
      display: none;
    }
    .tabs:has(> .sectionhead > .tablist > label:nth-of-type(1) > input:checked)
      > .panels
      > .connection:nth-child(1),
    .tabs:has(> .sectionhead > .tablist > label:nth-of-type(2) > input:checked)
      > .panels
      > .connection:nth-child(2) {
      display: grid;
    }
  }

  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
    padding: 70px 0 76px;
  }
  .hero h1 {
    margin-bottom: 24px;
  }
  .intro .eyebrow {
    margin-bottom: 24px;
  }

  .picker {
    background: #fff;
    border: 1px solid var(--line);
    padding: 28px;
    display: grid;
    gap: 20px;
    min-width: 0;
  }
  .picker legend {
    font: 11px monospace;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 14px;
    padding: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips legend {
    width: 100%;
  }
  .chips span,
  .segmented span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line);
    font-size: 14px;
    background: var(--paper);
  }
  .chips input:checked + span,
  .segmented input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }
  .motor > * + * {
    margin-top: 18px;
  }
  .motor .panels {
    min-height: 150px;
  }
  .speed {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-bottom: 14px;
    color: var(--ink);
    font-size: 17px;
  }
  .speed .number {
    font-size: 92px;
    line-height: 1;
    letter-spacing: -0.06em;
  }
  .bar {
    height: 10px;
    background: #eceae1;
  }
  .fill {
    display: block;
    height: 100%;
    background: var(--accent);
  }
  .fill-25 {
    width: 55.5%;
  }
  .fill-32 {
    width: 71%;
    background: #b4561d;
  }
  .fill-45 {
    width: 100%;
    background: #9c3f0c;
  }
  .detail {
    margin: 14px 0 0;
    font-size: 14px;
  }
  .picker .status {
    justify-self: start;
    white-space: normal;
    margin: 0;
  }

  .segmented {
    display: flex;
    gap: 0;
  }
  .segmented label + label span {
    border-left: 0;
  }
  .connection {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .column {
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }
  .column h4,
  .safetynet h3 {
    font: 11px monospace;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin: 0 0 14px;
  }
  .column ul,
  .safetynet ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  .settings {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 40px;
    align-items: start;
  }
  .settings > *,
  #cli > *,
  .hero > * {
    min-width: 0;
  }
  .side {
    display: grid;
    gap: 6px;
  }
  .side span {
    display: grid;
    gap: 3px;
    padding: 13px 16px;
    border: 1px solid transparent;
    background: #eceae1;
    font-size: 14px;
  }
  .side strong {
    font-weight: 600;
  }
  .side small {
    font-size: 12px;
    color: var(--muted);
  }
  .side input:checked + span {
    background: #fff;
    border-color: var(--accent);
  }
  .group h3 {
    margin-bottom: 8px;
  }
  .group tbody th {
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink);
    font-weight: 600;
  }
  .appshot {
    margin-top: 48px;
    max-width: 900px;
  }
  .appshot img {
    border: 1px solid var(--line);
  }

  .safety {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
  }
  .safetynet {
    background: #e7e9dd;
    padding: 26px;
  }

  .fold {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 30px 0 0;
    font: 11px monospace;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
  }
  .fold:before,
  .fold:after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--line);
  }
  #cli {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 48px;
    align-items: start;
    border-top: 0;
  }
  .cliintro .side {
    margin: 26px 0 6px;
  }
  .terminal pre {
    margin: 0;
    padding: 24px;
    background: #1f2a1f;
    color: #e6ebe2;
    font: 13px/1.7 monospace;
    overflow-x: auto;
  }
  .terminal pre:focus-visible {
    outline: 3px solid #d77b30;
    outline-offset: 3px;
  }
  .terminal p {
    font-size: 14px;
    margin-top: 14px;
  }

  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: center;
  }
  .story img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    filter: saturate(0.5);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 1000px) {
    .connection {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 900px) {
    .hero,
    .safety,
    #cli,
    .settings {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .hero {
      padding-top: 48px;
    }
    .story {
      gap: 35px;
    }
  }
  @media (max-width: 760px) {
    .story,
    .connection {
      grid-template-columns: 1fr;
    }
    .picker {
      padding: 20px;
    }
    .speed .number {
      font-size: 72px;
    }
    .story img {
      height: 250px;
    }
  }
</style>
