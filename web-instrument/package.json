{
  "name": "cranklink-web-instrument",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/copy-runtime-assets.mjs",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test *.test.ts",
    "test:fast": "node --experimental-strip-types --test *.test.ts",
    "pretest:smoke": "node scripts/ensure-port-free.mjs",
    "test:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "pretest:e2e": "node scripts/ensure-port-free.mjs",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build:cloudflare": "./scripts/build-cloudflare.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "nano-staged": "^1.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.45",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
